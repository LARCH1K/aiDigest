# Переменные docker compose на сервере. Скопировать в .env рядом с docker-compose.yml.
# Тег образов бэкенда и фронтенда в GHCR
AIDIGEST_VERSION=latest
# Папка данных на хосте (подкаталоги postgres и backend)
AIDIGEST_DATA_HOST=/srv/aidigest/data
# Папка с секретами: web.env, tavily.env, litellm.env
AIDIGEST_SECRETS=/srv/aidigest/secrets
# Порт сайта на хосте
AIDIGEST_HTTP_PORT=80
# Пользователь бэкенда (владелец подкаталога backend)
AIDIGEST_UID=1000
AIDIGEST_GID=1000
# Только буквы и цифры, например пароль из команды openssl rand -hex 24
POSTGRES_PASSWORD=
# Установить 1 при доступе к сайту только по HTTPS
AIDIGEST_SECURE_COOKIE=0
