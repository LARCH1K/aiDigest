# Переменные docker compose на сервере. Скопировать в .env рядом с docker-compose.yml.
# Папка данных на хосте (cases.json, кеш, выгрузки, состояние запусков)
AIDIGEST_DATA_HOST=/srv/aidigest/data
# Папка с секретами: web.env, tavily.env, litellm.env
AIDIGEST_SECRETS=/srv/aidigest/secrets
# Порт сайта на хосте
AIDIGEST_HTTP_PORT=80
# Пользователь, от которого работают контейнеры (владелец AIDIGEST_DATA_HOST)
AIDIGEST_UID=1000
AIDIGEST_GID=1000
